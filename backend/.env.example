# Copy to backend/.env for local work. On Render, enter these in the dashboard instead. NEVER commit the real file.

# Supabase > Project Settings > Database > Connection string > "Session pooler" (works on Render, IPv4-friendly)
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://PROJECTREF.supabase.co

# Only if your project still uses the legacy shared JWT secret (Settings > API > JWT Secret). Leave empty otherwise.
SUPABASE_JWT_SECRET=

# Comma-separated list of frontend addresses allowed to call this API (no trailing slash)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Optional regex to also allow Vercel preview URLs, e.g. https://aquatrack-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Optional: long random string. Lets a scheduler call POST /api/v1/internal/run-checks (header X-Cron-Secret)
CRON_SECRET=
